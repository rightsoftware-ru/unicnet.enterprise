# Переменные окружения для Docker Compose (формат KEY=VALUE)
# Скопируйте файл в app/.env и заполните реальными значениями.

# PostgreSQL
POSTGRES_DB=unicnetdb
POSTGRES_USER=unicnet
POSTGRES_PASSWORD=change_me_postgres_password

# MongoDB - root пользователь (для инициализации)
MONGO_INITDB_ROOT_USERNAME=unicnet
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo_root_password

# MongoDB - основная база данных
MONGO_INITDB_DATABASE=unicnet_db

# MongoDB - UnicNet
MONGO_UNICNET_DB=unicnet_db
MONGO_UNICNET_USER=unicnet
MONGO_UNICNET_PASSWORD=change_me_unicnet_password

# MongoDB - Logger
MONGO_LOGGER_DB=logger_db
MONGO_LOGGER_USER=logger_user
MONGO_LOGGER_PASSWORD=change_me_logger_password

# MongoDB - Vault
MONGO_VAULT_DB=vault_db
MONGO_VAULT_USER=vault_user
MONGO_VAULT_PASSWORD=change_me_vault_password

# Keycloak
KEYCLOAK_ADMIN_USER=unicnet
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_password

# Лицензия (обязательно замените на реальную перед запуском)
UniCommLicenseData=change_me_license

# Router (ожидается CIDR сети, например 192.168.0.1/24)
RouterCidr=192.168.0.1/24
