# Fill this file first, then: cp .env.example .env && chmod 600 .env
# Do not commit .env. Registry login is separate: docker login cr.yandex

# Image tags: <IMAGE>_IMAGE_TAG per service. Only immutable references:
# a dated tag (20260825-767ceff843ca) or a digest pin (dev@sha256:...).
# Floating dev/prod/latest without @sha256 are rejected by install.sh.
# Frontend repository is unic/unicnetfront (unic/unfront is the legacy UN.Front, do not use).
# Digests below are the set verified together on 2026-10-05.
PG_IMAGE_TAG=18
KEYCLOAK_IMAGE_TAG=26.7.0
UNICVAULT_IMAGE_TAG=dev@sha256:0b19e8477f92e346bdc179b86d6649c479db4595c6883b33650906b593f7cf2c
UNICLOGGER_IMAGE_TAG=dev@sha256:0c68be38969c9f78253454ff0868dec4d6ee541bf2a5eb10149df851246730b9
UNICNETROUTER_IMAGE_TAG=dev@sha256:29b5fd1f8be9bfe21dde2b9b840c25b74f21ef059c3cb81b8972c593250668cf
UNICNETSYSLOG_IMAGE_TAG=dev@sha256:1ef285f491b86593edcef3cbee188dff794eb3240156704ac64b9a7a21311b10
UNICNETBACKEND_IMAGE_TAG=dev@sha256:c6e37155a36e993b06892db416609f2f5b51e971534fd7ce5dc76128c7cf40ff
UNICNETFRONT_IMAGE_TAG=dev@sha256:dbc4e7e7e752428409e44d1b37f09cd77e285c2bc7b06edda12f552faa23e4db

POSTGRES_DB=replace_with_current_database
POSTGRES_USER=replace_with_current_user
POSTGRES_PASSWORD=replace_with_current_password

KEYCLOAK_ADMIN=replace_with_current_admin
KEYCLOAK_ADMIN_PASSWORD=replace_with_current_admin_password
KEYCLOAK_PUBLIC_URL=http://replace-with-host-ip-or-dns:8095

VAULT_JWT_SIGNING_KEY=replace_with_at_least_32_random_characters
VAULT_JWT_ISSUER=UniComm PRO Software
VAULT_JWT_AUDIENCE=Service

UNIC_LICENSE_DATA=replace_with_current_license_jwt
API_LICENSE_URL=SET_SECRET_BEFORE_USE

# CIDR сети хоста, с которой Router ходит к устройствам. Пример: 198.51.100.10/24
ROUTER_CIDR=replace_with_host_network_cidr
